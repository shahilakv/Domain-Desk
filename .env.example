# Copy to .env (never commit .env). Values are in Supabase → Project Settings → API.
# Project URL only — no /rest/v1 suffix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key only. Never put a secret/service_role key in VITE_ variables.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Hostinger: HOSTINGER_API_TOKEN is a Supabase Edge Function secret only.
# Never add it here or to any VITE_ variable — it would be shipped to the browser.
